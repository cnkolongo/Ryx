# RYX Configuration — Copier en .env et adapter
# JAMAIS committer le .env avec des vraies valeurs

# ─── Mode déploiement ─────────────────────────────────────────────────────────
RYX_MODE=hub                    # hub | edge | hybrid
RYX_ENV=development             # development | staging | production

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ryx:ryx@localhost:5432/ryx
# En mode edge (SQLite) :
# DATABASE_URL=sqlite+aiosqlite:///./data/ryx_edge.db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ryxdev
MINIO_SECRET_KEY=ryxdev123
MINIO_SECURE=false

# ─── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=ryxdev-meili-key

# ─── Orthanc (DICOM) ──────────────────────────────────────────────────────────
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# ─── Auth JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGEZ-MOI-EN-PRODUCTION-MIN-32-CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── WhatsApp Business API ────────────────────────────────────────────────────
# RÈGLE : WhatsApp = token anonyme UNIQUEMENT. Jamais de PHI.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── Modèles IA ───────────────────────────────────────────────────────────────
MEDGEMMA_MODEL_PATH=/models/medgemma-1.5
MEDGEMMA_ONNX_PATH=/models/edge/medgemma-int8.onnx
PILLAR0_MODEL_PATH=/models/pillar-0
ONNX_EDGE_MODEL_PATH=/models/edge/

# ─── Knowledge Pack ───────────────────────────────────────────────────────────
KNOWLEDGE_PACK_PATH=/data/knowledge-pack
KNOWLEDGE_PACK_VERSION=unknown

# ─── Chemins locaux (développement) ───────────────────────────────────────────
MODELS_PATH=./models
EDGE_DATA_PATH=./edge-data
EDGE_MODELS_PATH=./models/edge
KNOWLEDGE_PACK_PATH=./knowledge-pack

# ─── Observabilité ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ryx
LOG_LEVEL=INFO
